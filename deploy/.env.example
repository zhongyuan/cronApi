# ============================================================
# 生产环境变量：复制为 .env 后填写，再以 env_file 挂给容器
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# 变量前缀固定为 CRONAPI_，嵌套 key 用下划线分隔
# ============================================================

# --- MySQL（公网服务器）---
CRONAPI_MYSQL_ENABLED=true
CRONAPI_MYSQL_HOST=8.8.8.8
CRONAPI_MYSQL_PORT=3306
CRONAPI_MYSQL_USER=cronapi
CRONAPI_MYSQL_PASSWORD=CHANGE_ME_strong_password
CRONAPI_MYSQL_DATABASE=cron_api
# 必须与服务端 time_zone 一致
CRONAPI_MYSQL_TIMEZONE=Asia/Shanghai
CRONAPI_MYSQL_MAX_OPEN_CONNS=50
CRONAPI_MYSQL_CONN_MAX_LIFETIME=30m

# --- Redis（建议同机）---
CRONAPI_REDIS_ENABLED=true
CRONAPI_REDIS_ADDR=127.0.0.1:6379
CRONAPI_REDIS_PASSWORD=

# --- 安全：至少 32 字节随机串，生成方式 openssl rand -base64 32 ---
CRONAPI_JWT_SECRET=CHANGE_ME_please_use_openssl_rand_base64_32

# --- 微信小程序 ---
CRONAPI_WECHAT_MOCK=false
CRONAPI_WECHAT_APP_ID=
CRONAPI_WECHAT_APP_SECRET=

# --- 运行环境 ---
CRONAPI_APP_ENV=prod
CRONAPI_SCHEDULER_TIMEZONE=Asia/Shanghai
